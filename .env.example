# =============================================================================
# Moonlight AI Reasoning Configuration
# =============================================================================
# Active provider: mock | ollama | ollama-cloud | meta (default: ollama)
# - mock: Deterministic offline fixture replay (no network / no credentials).
# - ollama / ollama-cloud: Development placeholder model.
# - meta: Meta Model API or any OpenAI-compatible partner endpoint.
MOONLIGHT_PROVIDER=ollama
PROVIDER=ollama

# -----------------------------------------------------------------------------
# Option A: Meta Model API (dev.meta.ai)
# -----------------------------------------------------------------------------
# API key obtained from dev.meta.ai
MODEL_API_KEY=
META_API_KEY=

# Base URL for Meta Model API endpoint (default: https://api.meta.ai/v1)
MOONLIGHT_META_BASE_URL=https://api.meta.ai/v1

# Target model identifier (default: muse-spark-1.3)
MOONLIGHT_META_MODEL=muse-spark-1.3

# -----------------------------------------------------------------------------
# Option B: OpenAI-Compatible Partner Endpoint (e.g. Baseten / Muse Spark Open)
# -----------------------------------------------------------------------------
# Set MOONLIGHT_PROVIDER=meta, provide your partner API key, and configure endpoint:
# MODEL_API_KEY=your_baseten_key
# BASETEN_API_KEY=your_baseten_key
# MOONLIGHT_META_BASE_URL=https://inference.baseten.co/v1
# MOONLIGHT_META_MODEL=meta-models/muse-spark-open-1026

# -----------------------------------------------------------------------------
# Temporary Development Placeholder: Ollama Cloud
# -----------------------------------------------------------------------------
OLLAMA_API_KEY=
OLLAMA_MODEL=gemma4:31b
OLLAMA_BASE_URL=https://ollama.com

