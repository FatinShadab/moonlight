# Model provider: one of mock, ollama, meta (default: ollama)
MOONLIGHT_PROVIDER=ollama
PROVIDER=ollama

# API key for Meta Model API
MODEL_API_KEY=
META_API_KEY=

# Base URL for Meta Model API (default: https://api.meta.ai/v1)
MOONLIGHT_META_BASE_URL=https://api.meta.ai/v1

# Model identifier for Meta Model API (default: muse-spark-1.3)
MOONLIGHT_META_MODEL=muse-spark-1.3

# API key for Ollama Cloud (temporary development placeholder)
OLLAMA_API_KEY=

# Model identifier for Ollama Cloud (temporary development placeholder)
OLLAMA_MODEL=gemma4:31b

# Base URL for Ollama Cloud (default: https://ollama.com)
OLLAMA_BASE_URL=https://ollama.com
